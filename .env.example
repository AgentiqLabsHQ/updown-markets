# Privy (wallet auth) — client-visible app id
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
# Browser RPC: use the same-origin proxy to avoid CORS and hide the key
NEXT_PUBLIC_RH_TESTNET_RPC=/api/rpc
# Server-only upstream RPC (Alchemy) the /api/rpc route forwards to
RH_TESTNET_RPC_UPSTREAM=https://robinhood-testnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Indexer GraphQL endpoint (optional; dashboard falls back to chain reads)
NEXT_PUBLIC_INDEXER_URL=http://localhost:42069

# Supabase (profiles / settings)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
