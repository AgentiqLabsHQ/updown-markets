# Robinhood Chain RPC (Alchemy). Keep real keys OUT of git.
RH_TESTNET_RPC=https://robinhood-testnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
RH_MAINNET_RPC=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Deployer. TESTNET-ONLY key/mnemonic — never put a mainnet key here.
# Provide ONE of PRIVATE_KEY or MNEMONIC.
PRIVATE_KEY=
MNEMONIC=

# Protocol config
ENTRY_VALUE_USD8=200000000        # $2.00 (1e8 scale)

# ── Mainnet-only real addresses (leave blank on testnet; Deploy uses mocks) ──
USDC_ADDRESS=
PYTH_ENTROPY_ADDRESS=
CHAINLINK_FEED_A=
CHAINLINK_FEED_B=
SEQUENCER_UPTIME_FEED=
UPDOWN_TOKEN_ADDRESS=
